Download File https://repo.steampowered.com/steam/archive/stable/steam_latest-stable.tar.gz
Download File https://github.com/TimeAndTimeStudio/Game-Web-Site/releases/download/icon/icons.tar.xz

dnf Install 
sudo dnf install glibc.i686 mesa-libGL.i686 libdrm.i686 libnsl.i686

Run
sudo rm steam
sudo mv bin_steam.sh steam
sudo mv steam /usr/bin/
sudo mv steam.desktop ~/.local/share/applications
sudo mkdir /usr/lib/steam
sudo mv bootstraplinux_ubuntu12_32.tar.xz /usr/lib/steam
sudo mv icons/* /usr/share/icons/hicolor
